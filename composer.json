{
  "name": "ezstudio/assistant",
  "description": "Web assistant node for EZStudioLab",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "symfony/framework-bundle": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/process": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true},
  "extra": {"symfony": {"allow-contrib": false, "require": "7.4.*"}}
}
