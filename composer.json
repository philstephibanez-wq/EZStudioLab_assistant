{
  "name": "ezstudio/assistant",
  "description": "Web assistant node for EZStudioLab",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "symfony/console": "^8.0",
    "symfony/framework-bundle": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/process": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true},
  "extra": {"symfony": {"allow-contrib": false, "require": "7.4.*"}},
  "require-dev": {
    "symfony/debug-bundle": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "phpunit/phpunit": "13.0"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist --no-progress"
  }
}
