{% extends 'base.html.twig' %}
{% block title %}EZStudioLab Assistant{% endblock %}
{% block body %}
<h1>EZStudioLab Assistant</h1>
<div class="grid">
  <div class="card"><div class="label">État</div><div id="state" class="value">Chargement…</div></div>
  <div class="card"><div class="label">Activité</div><div id="activity" class="value">—</div></div>
  <div class="card"><div class="label">LAB</div><div id="lab" class="value">REST</div></div>
  <div class="card"><div class="label">Modèles IA</div><div id="models" class="value">SMB</div></div>
  <div class="card"><div class="label">Moteur d’inférence</div><div id="inference-state" class="value">Vérification…</div><div id="inference-version">Version non vérifiée</div><div id="inference-model">Modèle non vérifié</div></div>
  <div class="card"><div class="label">Persistance</div><div class="value">LAB uniquement</div></div>
  <div class="card"><div class="label">Base Assistant</div><div class="value">Aucune</div></div>
</div>
<div class="card" style="margin-top:14px">
  <div class="label">Dernière trace locale PROFILE · historique, non liée au job sélectionné</div>
  <div id="consultation-state" class="value">Aucun traitement observé</div>
  <div id="consultation-detail">—</div>
  <progress id="consultation-progress" max="4" value="0" style="width:100%"></progress>
  <div class="label">Progression du traitement, pas taux de justesse · aucune validation scientifique implicite</div>
</div>
<section class="card" style="margin-top:14px" aria-labelledby="lab-review-title">
  <h2 id="lab-review-title">Historique des contre-expertises PROFILE · résultats LAB</h2>
  <p id="lab-review-explanation">Historique LAB : cette révision peut concerner une autre chanson. Elle n'est jamais présentée comme le résultat du job en cours. Pour demander une révision déterminée, utiliser ?run_id=NUMERO dans l'URL.</p>
  <div id="lab-review-state" role="status">Chargement…</div>
  <div id="lab-review-results"></div>
  <button type="button" id="lab-review-refresh">Actualiser les résultats LAB</button>
</section>
{% endblock %}
{% block javascripts %}
<script>
(function(){
    var state=document.getElementById('lab-review-state');
    var output=document.getElementById('lab-review-results');
    var button=document.getElementById('lab-review-refresh');
    function element(tag,value){
        var node=document.createElement(tag);
        if(value!==undefined)node.textContent=String(value);
        return node;
    }
    function refresh(){
        var selection=new URLSearchParams(window.location.search);
        var run=selection.get('run_id');
        var scoped=run!==null && /^[1-9][0-9]*$/.test(run);
        state.textContent=scoped?'Lecture de la révision LAB du run #'+run+'…':'Lecture de la dernière révision historique LAB (non liée au job actuel)…';
        fetch('/api/profile/latest-review'+(scoped?'?run_id='+encodeURIComponent(run):''),{cache:'no-store'})
            .then(function(response){return response.json();})
            .then(function(data){
                output.replaceChildren();
                if(!data.ok){state.textContent='Erreur technique : '+(data.error||'LAB inaccessible')+(data.reason?' · '+data.reason:'');return;}
                if(data.state!=='available'){state.textContent=scoped?'Aucune révision pour le run #'+run+'.':'Aucune contre-expertise persistée dans LAB.';return;}
                if(scoped && String(data.run_id)!==String(run)) {
                    state.textContent='Réponse LAB non conforme : révision d’un autre run. Affichage bloqué.';
                    return;
                }
                var declared=data.identity_declared||{};
                state.textContent=(scoped?'Révision du run demandé #'+run+' · ':'HISTORIQUE LAB — PAS LE JOB COURANT · ')+'Analyse #'+(data.analysis_reference||data.run_id)+' · Preset #'+(data.preset_reference||'non renseigné')+' · Révision #'+data.revision_id+' · '+data.status+
                    ' · Identité déclarée : '+(declared.title||'?')+' — '+(declared.artist||'?')+
                    ' · Correspondance de l’enregistrement non confirmée';
                var doc=data.documentary_catalogue_suggestions||{};
                if(doc.schema){
                    var block=element('section');block.className='card';block.style.marginTop='12px';
                    block.appendChild(element('h3','Identité et crédits proposés · avis consultatif'));
                    var work=doc.work||{}, recording=doc.recording||{};
                    function field(name,value){
                        var values=Array.isArray(value)?value:[value];
                        var label=values.filter(function(v){return v&&v.value;}).map(function(v){
                            return v.value+' ('+(v.status||'inconnu')+')';
                        }).join(', ');
                        block.appendChild(element('p',name+' : '+(label||'Non documenté')));
                    }
                    field('Titre complet',work.full_title);
                    field('Interprètes',recording.performers);
                    field('Paroliers / auteurs',work.lyricists);
                    field('Compositeurs',work.composers);
                    field('Arrangeurs',recording.arrangers);
                    (doc.consulted_identity_sources||[]).forEach(function(url){
                        if(typeof url!=='string'||!url.startsWith('https://'))return;
                        var link=element('a',url);link.href=url;link.target='_blank';link.rel='noopener noreferrer';
                        block.appendChild(link);
                    });
                    output.appendChild(block);
                }
                var labels={'duration':'Durée','tempo':'Tempo','meter':'Mesure','key':'Tonalité',
                    'genre':'Genre','instrument:0':'Instruments','lead_vocal':'Voix principale',
                    'backing_vocals':'Voix d’accompagnement','vocal_harmonies':'Harmonies vocales','choir':'Chœurs'};
                (data.items||[]).forEach(function(item){
                    var card=element('div');card.className='card';card.style.marginTop='8px';
                    output.appendChild(card);
                    card.appendChild(element('h3',labels[item.key]||item.key));
                    card.appendChild(element('p','LAB : '+(item.lab_value||'non renseigné')));
                    card.appendChild(element('p','Référence : '+(item.external_value||'non trouvée')));
                    var outcome=element('p','Avis : '+(item.verdict||'INCONNU')+' · '+(item.reason||'Aucune justification disponible'));
                    outcome.style.padding='6px 10px';
                    outcome.style.borderRadius='6px';
                    outcome.style.background=item.verdict==='BON'?'#173a2b':item.verdict==='MAUVAIS'?'#46232a':'#303842';
                    outcome.style.color=item.verdict==='BON'?'#93edb9':item.verdict==='MAUVAIS'?'#ffb3b3':'#c8d0db';
                    card.appendChild(outcome);
                    var observation=item.documentary_observation||{};
                    if(observation.status){
                        var cmp={concordant:'CONCORDANTE',discordant:'DISCORDANTE',indeterminate:'INDÉTERMINÉE'};
                        var indicator=element('p','Comparaison documentaire : '+(cmp[observation.comparison]||'INDÉTERMINÉE'));
                        indicator.style.padding='6px 10px';
                        indicator.style.borderRadius='6px';
                        indicator.style.background=observation.comparison==='concordant'?'#1b3852':observation.comparison==='discordant'?'#4b321a':'#303842';
                        indicator.style.color=observation.comparison==='concordant'?'#a0d6ff':observation.comparison==='discordant'?'#ffd596':'#c8d0db';
                        card.appendChild(indicator);
                        if(observation.reference_value)card.appendChild(element('p','Valeur documentaire : '+observation.reference_value));
                        card.appendChild(element('p','Enregistrement exact non confirmé · verdict scientifique inchangé.'));
                        (observation.citations||[]).forEach(function(url,index){
                            if(typeof url!=='string'||!url.startsWith('https://'))return;
                            var link=element('a','Référence documentaire '+(index+1));
                            link.href=url;link.target='_blank';link.rel='noopener noreferrer';
                            card.appendChild(link);
                        });
                    }
                    var urls=Array.from(new Set(item.sources||[]));
                    if(!urls.length)card.appendChild(element('p','Aucune source lue.'));
                    urls.forEach(function(url){
                        if(typeof url!=='string'||!url.startsWith('https://'))return;
                        var link=element('a','Source consultée');
                        link.href=url;link.target='_blank';link.rel='noopener noreferrer';
                        card.appendChild(link);
                    });
                });
            })
            .catch(function(){state.textContent='Erreur technique : lecture LAB indisponible';});
    }
    button.addEventListener('click',refresh);
    refresh();
})();
</script>


<script>
(function inferencePoll(){
  $.getJSON('/api/inference/status').done(function(d){
    $('#inference-state').text(d.state==='READY'?'PRÊT':'INDISPONIBLE').attr('class','value '+(d.ok?'ok':'bad'));
    $('#inference-version').text('Moteur : '+(d.engine||'llama.cpp')+' · version '+(d.engine_version||'non exposée'));
    $('#inference-model').text('Modèle : '+(d.model||'non identifié'));
  }).fail(function(xhr){
    $('#inference-state').text('INDISPONIBLE').attr('class','value bad');
    $('#inference-version').text('Version non vérifiée');
    $('#inference-model').text('Inférence inaccessible');
  }).always(function(){setTimeout(inferencePoll,5000);});
})();
(function poll(){
  $.getJSON('/api/status').done(function(s){
    $('#state').text(s.state||'UNKNOWN').attr('class','value '+(s.ok?'ok':'bad'));
    $('#activity').text(s.activity||'—');

    var lab=s.lab_rest||{};
    var labOk=!!(lab.reachable&&lab.authorized);
    $('#lab')
      .text((labOk?'OK · ':'KO · ')+(lab.base_url||'REST'))
      .attr('class','value '+(labOk?'ok':'bad'));

    var m=s.models||{};
    $('#models')
      .text((m.accessible?'OK · ':'KO · ')+(m.root||'SMB'))
      .attr('class','value '+(m.accessible?'ok':'bad'));

    var c=s.profile_consultation||{};
    var name={not_started:'Non démarré',in_progress:'En cours',completed:'Terminé',error:'Échec',unavailable:'Indisponible'};
    $('#consultation-state').text('Historique local : '+(name[c.state]||'État inconnu'));
    $('#consultation-detail').text(c.run_id ? ('ANCIENNE TRACE — PAS LE JOB COURANT · Run #'+c.run_id+' · '+(c.stage||'—')+' · '+(c.completed||0)+' / '+(c.total||4)+' étapes'+(c.verified_count===null||c.verified_count===undefined?'':' · '+c.verified_count+' valeurs examinées · '+(c.evidence_count||0)+' justifiées')+(c.revision?' · révision #'+c.revision:'')) : 'Aucune trace de vérification indépendante locale');
    $('#consultation-progress').attr('max',c.total||4).val(c.completed||0);

  }).fail(function(xhr){
    $('#state').text('ERROR').attr('class','value bad');

  }).always(function(){
    setTimeout(poll,3000);
  });
})();
</script>
{% endblock %}
