{% extends 'base.html.twig' %}{% block title %}Assistant XPS{% endblock %}{% block body %}<h1>Assistant XPS</h1><div class="grid"><div class="card"><div class="label">État</div><div id="state" class="value">Chargement…</div></div><div class="card"><div class="label">Activité</div><div id="activity" class="value">—</div></div><div class="card"><div class="label">LAB</div><div id="lab" class="value">REST</div></div><div class="card"><div class="label">Modèles IA</div><div id="models" class="value">SMB</div></div><div class="card"><div class="label">Persistance</div><div class="value">LAB uniquement</div></div><div class="card"><div class="label">Base Assistant</div><div class="value">Aucune</div></div></div><div class="card" style="margin-top:14px"><div class="label">Runtime Python</div><pre id="runtime">—</pre></div>{% endblock %}{% block javascripts %}<script>(function poll(){$.getJSON('/api/status').done(function(s){$('#state').text(s.state||'UNKNOWN').attr('class','value '+(s.ok?'ok':'bad'));$('#activity').text(s.activity||'—');$('#lab').text((s.lab_rest&&s.lab_rest.base_url)||'REST');var m=s.models||{};$('#models').text((m.accessible?'OK · ':'KO · ')+(m.root||'SMB')).attr('class','value '+(m.accessible?'ok':'bad'));$('#runtime').text(JSON.stringify(s.runtime||{},null,2));}).fail(function(xhr){$('#state').text('ERROR').attr('class','value bad');$('#runtime').text(xhr.responseText||'status unavailable');}).always(function(){setTimeout(poll,3000);});})();</script>{% endblock %}
