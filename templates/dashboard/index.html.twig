{% extends 'base.html.twig' %}
{% block title %}EZStudioLab Assistant{% endblock %}
{% block body %}
<h1>EZStudioLab Assistant</h1>
<div class="grid">
  <div class="card"><div class="label">État</div><div id="state" class="value">Chargement…</div></div>
  <div class="card"><div class="label">Activité</div><div id="activity" class="value">—</div></div>
  <div class="card"><div class="label">LAB</div><div id="lab" class="value">REST</div></div>
  <div class="card"><div class="label">Modèles IA</div><div id="models" class="value">SMB</div></div>
  <div class="card"><div class="label">Persistance</div><div class="value">LAB uniquement</div></div>
  <div class="card"><div class="label">Base Assistant</div><div class="value">Aucune</div></div>
</div>
<div class="card" style="margin-top:14px">
  <div class="label">Vérification PROFILE · sources indépendantes</div>
  <div id="consultation-state" class="value">Aucun traitement observé</div>
  <div id="consultation-detail">—</div>
  <progress id="consultation-progress" max="4" value="0" style="width:100%"></progress>
  <div class="label">Progression du traitement, pas taux de justesse · aucune validation scientifique implicite</div>
</div>
<div class="card" style="margin-top:14px">
  <div class="label">Runtime Python</div>
  <pre id="runtime">—</pre>
</div>
{% endblock %}
{% block javascripts %}
<script>
(function poll(){
  $.getJSON('/api/status').done(function(s){
    $('#state').text(s.state||'UNKNOWN').attr('class','value '+(s.ok?'ok':'bad'));
    $('#activity').text(s.activity||'—');

    var lab=s.lab_rest||{};
    var labOk=!!(lab.reachable&&lab.authorized);
    $('#lab')
      .text((labOk?'OK · ':'KO · ')+(lab.base_url||'REST'))
      .attr('class','value '+(labOk?'ok':'bad'));

    var m=s.models||{};
    $('#models')
      .text((m.accessible?'OK · ':'KO · ')+(m.root||'SMB'))
      .attr('class','value '+(m.accessible?'ok':'bad'));

    var c=s.profile_consultation||{};
    var name={not_started:'Non démarré',in_progress:'En cours',completed:'Terminé',error:'Échec',unavailable:'Indisponible'};
    $('#consultation-state').text(name[c.state]||'État inconnu');
    $('#consultation-detail').text(c.run_id ? ('Run #'+c.run_id+' · '+(c.stage||'—')+' · '+(c.completed||0)+' / '+(c.total||4)+' étapes'+(c.verified_count===null||c.verified_count===undefined?'':' · '+c.verified_count+' valeurs examinées · '+(c.evidence_count||0)+' justifiées')+(c.revision?' · révision #'+c.revision:'')) : 'Aucune vérification indépendante locale');
    $('#consultation-progress').attr('max',c.total||4).val(c.completed||0);
    $('#runtime').text(JSON.stringify(s.runtime||{},null,2));
  }).fail(function(xhr){
    $('#state').text('ERROR').attr('class','value bad');
    $('#runtime').text(xhr.responseText||'status unavailable');
  }).always(function(){
    setTimeout(poll,3000);
  });
})();
</script>
{% endblock %}
